# Environment Variables for Deployify
# Copy this file to .env.local and fill in your values

# ============= Application =============
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ============= GitHub OAuth =============
# Create a GitHub OAuth App at: https://github.com/settings/developers
# Set callback URL to: http://localhost:3000/api/auth/callback
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

# ============= GitHub Webhooks =============
# Generate a secure random string for webhook signature verification
GITHUB_WEBHOOK_SECRET=your_webhook_secret

# ============= GCP Configuration =============
# Your GCP project ID
GCP_PROJECT_ID=your_gcp_project_id

# Your GCP project number (optional, used for Cloud Run URL construction)
GCP_PROJECT_NUMBER=your_gcp_project_number

# GCP region for Cloud Run deployments (recommend asia-south1 for India)
GCP_REGION=asia-south1

# Artifact Registry repository name
GCP_ARTIFACT_REGISTRY=deployify-images

# ============= Firebase/Firestore =============
# If running locally, you can use the same GCP project ID
FIREBASE_PROJECT_ID=your_gcp_project_id

# Service account credentials (for local development)
# Generate a service account key at: https://console.cloud.google.com/iam-admin/serviceaccounts
FIREBASE_CLIENT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ============= JWT Session =============
# Generate a secure random string: openssl rand -base64 32
JWT_SECRET=your_jwt_secret_here

# Secret for AES-256-GCM encryption of environment variables
# Generate a 32-byte key: openssl rand -hex 32
ENCRYPTION_KEY=your_encryption_key_here

# ============= Rate Limiting =============
# Requests per window
RATE_LIMIT_REQUESTS=100

# Window duration in milliseconds (60000 = 1 minute)
RATE_LIMIT_WINDOW_MS=60000

# ============= Billing (Stripe) =============
STRIPE_SECRET_KEY=your_stripe_secret_key

# ============= Billing (Razorpay) =============
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
# How /api/billing/verify decides which tier to grant.
# enforce (default) = tier comes from the server-side order record / Razorpay order notes
# monitor           = log mismatches but keep granting the client-supplied tier (rollback switch)
# off               = no server-side corroboration (forced on when MOCK_DB=true)
# BILLING_VERIFY_TIER_MODE=enforce
#
# Whether /api/billing/verify also corroborates the *payment* against Razorpay.
# The checkout signature is only HMAC(orderId|paymentId): it proves the pair came out of
# Razorpay checkout, not that money was taken or how much.
# monitor (default) = fetch the payment and log wrong-order / failed / short-paid, grant as today
# enforce           = reject those. 'authorized' is still accepted (auto-capture can lag the handler)
# off               = no payment lookup (forced on when MOCK_DB=true)
# BILLING_VERIFY_PAYMENT_MODE=monitor
#
# Whether a paid plan whose billing period has ended still counts as paid.
# Both writers set subscription.currentPeriodEnd (+30 days); until this flag existed
# nothing ever compared it to the clock, so a single payment granted its tier forever.
# audit (default) = resolve the stored tier exactly as today, but log every lapse so you
#                   can size the blast radius first (grep for '[Entitlement]')
# enforce         = a lapsed paid plan resolves to 'free' for usage/provision/compute gates
# off             = kill switch, no evaluation at all (forced on when MOCK_DB=true)
# A subscription with no usable end date is NEVER treated as lapsed, in any mode.
# BILLING_ENTITLEMENT_MODE=audit
#
# Days past currentPeriodEnd before a plan is considered lapsed, so one late Razorpay
# redelivery cannot cut a paying tenant off. Clamped to [0, 90]. Not applied to a
# subscription explicitly marked canceled/unpaid.
# BILLING_ENTITLEMENT_GRACE_DAYS=3

# ============= CLI login (optional) =============
# Loopback host used for the `deployify login` callback redirect.
# Allowed values: localhost (default), 127.0.0.1, [::1]. Anything else is ignored.
# DEPLOYIFY_CLI_CALLBACK_HOST=localhost

# --- Phase 126: Shared-platform-SA IAM remediation (defect ai-cost-abuse-1) ---
# Project-level IAM revocation on the shared Deployify service account is a platform-operator
# action: one revoke degrades every tenant. Leave unset (default) to have the
# 'overprivileged_service_account' / 'broad_secret_access' remediations apply only the safe,
# resource-scoped Secret Manager grants and defer the revoke.
IAM_SELF_REMEDIATION_ENABLED=false
# Extra roles the automated remediation may revoke, beyond EXCESSIVE_PROJECT_ROLES (comma-separated).
# IAM_REMEDIATION_EXTRA_REVOCABLE_ROLES=
# Allow revoking roles/resourcemanager.projectIamAdmin from the platform SA (self-lockout: the
# platform can no longer write IAM afterwards). Default false.
IAM_ALLOW_SELF_LOCKOUT_REVOKE=false
# Strip server-owned keys (provisioned, projectId, excessiveRoles, ...) from storage PATCH/POST
# request metadata instead of only warning. Flip on after confirming the warn logs are quiet.
# Server-owned storage metadata keys (provisioned, resourceName, excessiveRoles, ...) are
# STRIPPED from request bodies by default. They gate GCP deletion, IAM remediation and the
# Data Lab database binding, so a request must never set them. Set to false only to restore
# the old warn-only behaviour while investigating an unexpected caller.
STORAGE_METADATA_STRICT=true

# --- Team-scope enforcement for workspace-wide infrastructure reports (defect authn-session-3) ---
# GET /api/infrastructure/health and /api/infrastructure/compliance-report verify TEAM_MEMBERSHIPS
# before serving ?teamId=<id>, matching GET /api/projects and POST /api/infrastructure/remediate.
# Default (unset) = enforce. Set to 'report' as an emergency kill-switch: the pre-fix data is
# served and the would-be denial is logged as '[team-scope] would-deny'.
# INFRA_TEAM_SCOPE_ENFORCEMENT=enforce

# --- Global project-slug uniqueness (defect tenancy-data-2) ---
# A project's slug names a GLOBAL Cloud Run service (dfy-<slug>) and the public hostname
# <slug>.deployify.io, but uniqueness used to be checked per-user only.
# suffix (default) = a globally-taken slug gets a short random suffix. Creates never fail.
# enforce          = reject the create with the existing 400 "A project with this name already exists"
# off              = break-glass, restores the pre-fix per-user-only check (forced on when MOCK_DB=true)
# PROJECT_SLUG_UNIQUENESS_MODE=suffix
#
# How a slug collision that ALREADY exists in Firestore is resolved for hostname routing
# and for the deploy-time ownership guard.
# legacy (default) = whatever Firestore returns first, i.e. exactly today's behaviour.
#                    Collisions are logged either way, so run in legacy first and read the logs.
# oldest-wins      = the project created first owns the hostname and the Cloud Run service;
#                    newer projects on that slug are refused a deploy (403).
# PROJECT_SLUG_RESOLUTION_MODE=legacy

# --- Team invite role guard (defect tenancy-data-4) ---
# POST /api/teams/[id]/invite gated on owner-OR-admin and then accepted role='owner'
# without the requester-role cross-check the sibling PATCH endpoint enforces, so a team
# admin could mint an owner-grade invite and redeem it themselves.
# enforce (default) = only an owner may issue an invite with role='owner'; an admin gets 403.
#                     Safe as a default: the UI's invite control only offers admin|member|viewer,
#                     so no first-party flow can reach this branch.
# warn              = log the attempt, still create the invite (pre-fix behaviour)
# off               = break-glass, no logging
# TEAM_INVITE_ROLE_GUARD_MODE=enforce
#
# Backstop for owner-grade invites already sitting in Firestore from before the guard.
# Re-checks, at redemption time, that the inviter is still an owner of the team.
# warn (default) = log only, redemption proceeds exactly as today. Invites expire after
#                  7 days, so the pre-fix backlog drains on its own within a week.
# enforce        = refuse the redemption with 403 (flip only after the audit log is clean)
# off            = no check, no logging
# TEAM_INVITE_ACCEPT_GUARD_MODE=warn

# --- Repo -> project binding integrity (defect injection-db-5) ---
# POST /api/projects only ever checked that the caller can READ the repo (octokit
# repos.get), and the webhook HMAC secret is global, so a second project could be bound to
# someone else's repoFullName and win the limit(1) lookup that routes inbound deliveries.
# Admin rights are recorded at bind time in project.repoVerification and used to break ties.
# warn (default) = record the evidence and audit cross-tenant binds. Blocks nobody.
# enforce        = 403 when a caller with no admin rights binds a repo another tenant holds.
# off            = break-glass, restores the pre-fix behaviour (forced on when MOCK_DB=true)
# PROJECT_REPO_BINDING_MODE=warn
#
# How a repoFullName collision that ALREADY exists in Firestore is resolved for webhooks.
# legacy (default) = whatever Firestore returns first, i.e. exactly today's behaviour.
#                    Cross-tenant collisions are logged in BOTH modes, so run legacy first
#                    and read the logs before flipping.
# verified-first   = among projects of DIFFERENT tenants, the oldest admin-verified one wins.
#                    A single tenant with several projects on one repo (monorepo) is never
#                    re-pointed, and an already-verified incumbent is never displaced.
# PROJECT_REPO_RESOLUTION_MODE=legacy

# --- Team membership document integrity (defect tenancy-data-3) ---
# `teamMemberships` has no (teamId,userId) uniqueness constraint. Redeeming an invite used
# to always mint a new tm_<random> document, while removing a member deletes only the one
# document the lookup resolved - so a duplicate kept the removed member's access alive.
# Default (unset) = strict:
#   - accepting an invite is idempotent per member (transactional, deterministic doc id)
#   - removing a member deletes EVERY membership document for that member
#   - a role change applies to every one of them
#   - duplicates resolve to the highest-privilege document instead of an arbitrary one
#   - the last-owner guard counts distinct people, not documents
# All of the above are no-ops on a team with one document per member.
# Set to 'legacy' as a break-glass switch to restore the pre-fix code paths
# (forced on when MOCK_DB=true - the mock Firestore ignores .where()).
# TEAM_MEMBERSHIP_INTEGRITY_MODE=strict

# --- Exactly-once deployment finalization (defect reliability-races-2) ---
# syncDeploymentStatus() checks for a terminal status, then spends ~1-3s in sequential GCP
# calls before it writes one. Four entry points poll it concurrently (logs modal every 3s,
# deployments page every 5s, project overview, in-process pollBuildStatus every 30s), so on
# a normal successful build several of them clear that check and every side effect AFTER the
# terminal write runs once per poller: the trackDeployment() usage/build-minute increments,
# the success/failure email, the PR comment, the GitHub deployment status, productionUrl,
# image pruning and the Lighthouse run.
# 'guard' makes the terminal write a Firestore compare-and-set on the existing `status`
# field, so exactly one poller runs the side effects. No new field, no new collection, no
# migration - a row written before this flag existed behaves identically.
#   off   - DEFAULT. Kill switch. Plain updateDeployment(), no transaction, no extra read.
#   audit - logs (a lower bound on) how often the race actually fires on this deployment.
#           Still writes and still runs every side effect exactly as today.
#   guard - the compare-and-set. Losers return the finalized row and run nothing.
# Forced to 'off' when MOCK_DB=true (the mock Firestore's runTransaction returns a canned
# 'ready' document, which would suppress every side effect). Any transaction failure falls
# back to the unguarded write, so a Firestore hiccup can never strand a build at 'building'.
# Rollout: leave unset -> 'audit' for a few days -> 'guard'.
# DEPLOYMENT_FINALIZE_MODE=guard

# --- Data Lab query proxy (src/app/api/projects/[id]/storage/[storageId]/query) ---
# Max characters accepted for a Data Lab query. Route Handlers have no body size
# limit (next.config.ts's experimental.serverActions.bodySizeLimit covers Server
# Actions only), and every downstream scan is linear-or-worse in query length.
# Raise this only if a tenant legitimately runs larger queries. Default: 100000.
# DATALAB_MAX_QUERY_CHARS=100000
#
# Escape hatch: accept variable names outside /^[A-Za-z0-9_]+$/. The Data Lab UI
# only ever emits identifier names (it discovers them with /:[a-zA-Z0-9_]+/g), so
# this should stay unset. Default: unset (strict).
# DATALAB_ALLOW_NON_IDENTIFIER_VARIABLE_NAMES=true
#
# Escape hatch for the one-click index optimiser's `customSql` body field. That
# field reaches client.query()/connection.query() directly, and the simple-query
# protocol runs every statement in the string, so it is arbitrary SQL execution
# for any non-viewer team member. src/components/DataLab.tsx never sends it.
#   off        - reject any request carrying customSql (default)
#   validated  - allow a single CREATE/DROP INDEX, REINDEX, ANALYZE, OPTIMIZE TABLE
#   raw        - pre-fix behaviour: execute customSql verbatim (break-glass only)
# DATALAB_APPLY_INDEX_CUSTOM_SQL=off

# ============= CSRF / Request Provenance =============
# Guards the ambient-cookie session against forged cross-origin requests.
# Critical because tenant apps run at <slug>.<app-domain>, which is *same-site*
# with the dashboard, so SameSite=Lax alone does not protect the API.
#   off     - no check (pre-Phase-126 behaviour, emergency kill switch)
#   report  - log "[CSRF] would block ..." only, never rejects  (current default)
#   enforce - reject forged requests with 403
CSRF_ORIGIN_MODE=report

# Extra origins allowed to make credentialed cross-origin API calls
# (staging/preview dashboards). Comma-separated, scheme+host+port.
# The origin of NEXT_PUBLIC_APP_URL and its www/apex sibling are always allowed.
CSRF_ALLOWED_ORIGINS=

# Stage 3: also provenance-check GET/HEAD/OPTIONS. Off by default; a few GET
# handlers do mutate (storage sync, logout), but enabling this affects link-ins.
CSRF_PROTECT_SAFE_METHODS=false

# --- Orphan detection for "Purge All Orphans" (defect product-ux-6) ---
# GET /api/gcp/discover used to flag a resource ORPHANED when its name merely contained
# '-pr-' or '-branch-'. Deployify never provisions a per-PR Cloud SQL / Memorystore /
# Firestore instance (preview isolation rewrites the DATABASE NAME inside one instance,
# getBranchConnectionString in src/lib/db.ts), so that only ever matched resources the
# customer named themselves - and the "still active" exemption compared instance names
# against database-name patterns ('pr123'), so it never fired.
# Default (unset) = strict: a resource is ORPHANED only if it carries
#   managed-by=deployify AND deployify-project-id=<this project>, its name is exactly a
#   name this project's own deployments derive, and that deployment is no longer live.
#   Anything unproven stays ACTIVE. Firestore is never flagged (its v1 API has no labels).
# legacy = break-glass, restores the pre-fix substring heuristic verbatim.
# (Ignored when MOCK_DB=true - the mock discovery fixture is returned untouched.)
# GCP_ORPHAN_DETECTION=strict

# Defence in depth for DELETE /api/gcp/discover: refuse to delete a resource that still
# backs a registered storage connector (delete the connector instead, which also cleans up
# Firestore, Secret Manager and the injected env vars).
# Default (unset) = today's behaviour: a registered name is what GRANTS the delete.
# enforce = 403 "in use by a storage connector" instead. Flip after the strict orphan
#           detection above has soaked; it is unreachable from the UI either way.
# GCP_RECLAIM_INUSE_GUARD=enforce

# --- Custom-domain deletion role check (defect ssrf-proxy-8) ---
# DELETE /api/projects/[id]/domains authenticated the caller and confirmed team membership
# but never checked the ROLE, so any 'member' or 'viewer' could remove a live tenant's
# custom domain mapping from Cloud Run. It now applies the same owner|admin gate the POST
# handler in the same file has always applied.
# Default (unset) = enforce. Set to 'report' as an emergency kill-switch: the delete is
# performed and the would-be denial is logged as '[domain-rbac] would-deny'.
# DOMAIN_DELETE_ROLE_ENFORCEMENT=enforce

# ---------------------------------------------------------------------------
# UI legibility rollout (defect product-ux-7)
# The historical update_typography*.sh sed cascade left the whole product at
# 8-10px, and the LIGHT theme's status text at 1.79-3.29:1 contrast.
#   off      - today's rendering, unchanged. Default, and the kill switch.
#   contrast - light-theme status TEXT colours only. Colour-only, so no
#              element changes size and nothing can reflow. Safe first step.
#   full     - contrast + the type remap (8px -> 13px, 10px -> 16px).
#              This DOES reflow ~1540 call sites; soak it on staging first.
UI_LEGIBILITY_MODE=off

# Only read when UI_LEGIBILITY_MODE=full. Lets you dial the scale back from a
# tight layout without a code change or rollback. Integer px, 8px-24px;
# anything else is ignored in favour of the defaults below.
UI_TYPE_SCALE_BASE=13px
UI_TYPE_SCALE_LG=16px

# ============= Analytics Window Bounds =============
# GET /api/projects/[id]/analytics/stats reads `?period=` straight off the query
# string. It feeds a BigQuery INTERVAL, a Firestore `timestamp >=` predicate, and
# an Array.from({ length: days }) allocation, so it needs a ceiling.
#
# Largest window a caller may request, in days. The dashboard only ever emits
# 1h / 24h / 7d / 30d, so this is far above any first-party caller; a bookmarked
# ?period=90d still works. Anything larger is clamped silently - no status-code
# and no response-shape change. Lowering this to 30 matches the UI exactly and
# removes the last read amplification, at the cost of bookmarked long windows.
# Default: 365.
# ANALYTICS_MAX_PERIOD_DAYS=365
#
# Stage 2 (opt-in). Max analytics_events documents read per stats request.
# UNSET or 0 = no .limit() at all, i.e. exactly today's query; the handler only
# logs "[Analytics] Uncapped event scan read N docs ..." past 50000 so you can
# see whether any tenant is near the line before enforcing. Set a positive number
# to enforce. Ordered newest-first, so a cap truncates the oldest tail and will
# lower displayed totals for any tenant above it. Default: 0 (observe only).
# ANALYTICS_MAX_EVENT_SCAN=50000

# ============= Proxy rate limiting (defect input-validation-dos-6) =============
# src/proxy.ts is the platform's only global limiter. Pre-fix it keyed on
# `x-forwarded-for.split(',')[0]`, which Cloud Run's front end APPENDS to rather
# than replaces - so any caller could mint a fresh 30/min bucket per header
# value - and its Map had no eviction, so `/api/<random>` grew it until OOM.
#
# The store is now hard-capped unconditionally (eviction can only reset a
# counter, never create a 429). The identifier fix ships behind this flag:
#   legacy  - pre-fix request outcomes, bit for bit  (current default)
#   report  - log "[RateLimit] would block ..." only, still enforces legacy
#   enforce - key on the trusted (rightmost) XFF element
#   off     - no limiting at all (emergency kill switch)
# RATE_LIMIT_MODE=legacy

# Bucket granularity once RATE_LIMIT_MODE=enforce.
#   path  - `${ip}:${pathname}`, today's granularity  (default)
#   class - one bucket for all of /api/ per IP. This is what actually caps an
#           attacker (86 API routes x 100/min = 8600 rpm per IP under `path`),
#           but it is a real tightening for chatty dashboards. Ships dark.
# RATE_LIMIT_SCOPE=path

# Trailing x-forwarded-for elements written by infrastructure we control.
# 1 is correct for a Cloud Run domain mapping (one GFE hop). Set to 2 if the
# DASHBOARD is ever put behind a Global External ALB / serverless NEG, or every
# request collapses onto a handful of GFE IPs and shares one bucket.
# TRUSTED_PROXY_HOPS=1

# Hard cap on in-memory limiter entries per instance.
# RATE_LIMIT_MAX_ENTRIES=20000

# Per-window limits. Defaults reproduce the literals proxy.ts has always used.
# Deliberately NOT read from RATE_LIMIT_REQUESTS / RATE_LIMIT_WINDOW_MS above:
# those are already set on live revisions for the lib helper, and adopting them
# in the proxy would silently change the limits it has been running with.
# RATE_LIMIT_DEFAULT_REQUESTS=100
# RATE_LIMIT_STRICT_REQUESTS=30
# RATE_LIMIT_CLASS_REQUESTS=600
# RATE_LIMIT_STRICT_CLASS_REQUESTS=60
#
# KNOWN LIMITATION, not fixed here: this store is PER CLOUD RUN INSTANCE. The
# proxy is compiled as Edge middleware and cannot reach Redis/Firestore, so N
# instances mean an effective limit of N x the number above. A real global limit
# needs Cloud Armor rate-limiting on a load balancer in front of the service.

# Razorpay signs webhooks with a secret configured in the Razorpay dashboard under
# Settings > Webhooks. It is NOT the API key secret. If unset, the API key secret is used,
# which only works if you deliberately set both to the same value.
RAZORPAY_WEBHOOK_SECRET=
